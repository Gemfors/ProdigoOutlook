<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the parts of ProdigoOutlook that need no Outlook: the source files are
    compiled in directly (linked, not copied), so the tests always run against the
    real code. Same idea as ProdigoExcel's test\AuditCheck\LogicTests.

    Run from the repository folder:  dotnet run (project test\LogicTests)
    Exit code 0 means every check passed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>ProdigoOutlook.LogicTests</RootNamespace>
    <ProjectGuid>{312CB213-17F3-4FBA-8BF4-D907D4D024A5}</ProjectGuid>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\ProdigoOutlook\Core\TimeHelpers.cs" Link="Linked\TimeHelpers.cs" />
    <Compile Include="..\..\ProdigoOutlook\Features\SendLater\SendLaterTime.cs" Link="Linked\SendLaterTime.cs" />
    <Compile Include="..\..\ProdigoOutlook\Features\Availability\AvailabilityText.cs" Link="Linked\AvailabilityText.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
